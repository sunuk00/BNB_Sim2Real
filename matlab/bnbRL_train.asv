% % FILE: bnbRL_train.m
% % AUTH: Taeuk Sun
% % DATE: 09/05/26 13:40
% % DESC: Training BNB with RL
% 
% bnbRL_env;  % Initialize environment and agent (calls bnbRL_env.m)
% 
% % Training options: episodes, steps per episode, and plot settings
% trainOpts = rlTrainingOptions( ...
%     MaxEpisodes = 1000, ...
%     MaxStepsPerEpisode = 250, ...
%     StopTrainingCriteria = "None", ...
%     Verbose = false, ...
%     Plots = "training-progress");
% 
% % Train the agent with the specified environment and options
% trainStats = train(agent, env, trainOpts);
% 
% %{
%     <Experiment list>
%     1) exp01_base
%     2) exp02_obvNorm
%     3) exp03_obvNorm_aWeight
%     4) exp04_500step
%     5) exp05_500step_terminalPenalty
%     6) exp06_base_ratePenalty
%     7) exp07_base_obsNoise
%     8) exp08_base_obsNoise_filtered
%     9) exp09_base_filtered
%    10) exp10_curriculum_smallNoise        : exp01_base
% %}
% 
% expName = "exp09_base_filtered";
% save("exp_RL/" + expName + ".mat", "agent", "trainStats");


%---------

% FILE: bnbRL_curriculum.m
% AUTH: Taeuk Sun
% DATE: 09/12/26
% DESC: Continue training a noise-free agent under reduced observation noise
% NOTE: Simulink must already have the reduced noise set
%       (sigma_xdot = 0.010, sigma_x = 0.00022)

bnbRL_env;                                  % env 정의 (agent도 새로 생성됨)
load("exp_RL/exp01_base.mat", "agent");     % 학습된 agent로 덮어쓰기

agent.AgentOptions.ResetExperienceBufferBeforeTraining = false;

trainOpts = rlTrainingOptions( ...
    MaxEpisodes = 500, ...
    MaxStepsPerEpisode = 250, ...
    StopTrainingCriteria = "None", ...
    Verbose = false, ...
    Plots = "training-progress");

trainStats = train(agent, env, trainOpts);

expName = "exp10_curriculum_smallNoise";
save("exp_RL/" + expName + ".mat", "agent", "trainStats");